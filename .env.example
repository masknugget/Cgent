# Copy this file to .env and replace every placeholder.
# .env is loaded automatically and must never contain committed credentials.
HARNESS_WORKSPACES={"project":"/absolute/path/to/workspace"}
HARNESS_MODEL=replace-with-your-model-id
HARNESS_MODEL_API_KEY=replace-with-your-provider-key
HARNESS_MODEL_BASE_URL=https://api.openai.com/v1
HARNESS_MODEL_ADAPTER=http

# Authentication is disabled; only loopback addresses are accepted.
HARNESS_HOST=127.0.0.1
HARNESS_PORT=8000
HARNESS_MODEL_TIMEOUT_SECONDS=600
HARNESS_MODEL_MAX_RETRIES=3
HARNESS_AGENT_TIMEOUT_SECONDS=600
HARNESS_AGENT_MAX_STEPS=50

# Every configured executable must exist at startup. Use python.exe on Windows.
HARNESS_SHELL_ALLOWLIST=python
HARNESS_SHELL_TIMEOUT_SECONDS=300
HARNESS_SHELL_MAX_TIMEOUT_SECONDS=600
HARNESS_SHELL_MAX_OUTPUT_BYTES=1048576
HARNESS_MAX_CONCURRENT_SHELLS=4
HARNESS_SHELL_QUEUE_TIMEOUT_SECONDS=1
HARNESS_SHELL_KILL_GRACE_SECONDS=2

HARNESS_MAX_BODY_BYTES=4194304
HARNESS_MAX_FILE_BYTES=2097152
HARNESS_MAX_SEARCH_RESULTS=1000
HARNESS_ENABLE_DIRECT_TOOLS=true
# Optional: comma-separated host directories; each contains <skill-name>/SKILL.md.
# HARNESS_SKILLS_DIRS=F:/path/to/skills
# HARNESS_SHELL_ENV_ALLOWLIST=PATH,HOME,TEMP,TMP,SYSTEMROOT
